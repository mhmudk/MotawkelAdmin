<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/image_Item"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_foreground" />

            <!-- EditText -->
            <EditText
                android:id="@+id/item_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="لبن بخيرة "

                android:textColorHint="@color/black" />

            <!-- LinearLayout أفقي للأسعار -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <EditText
                    android:id="@+id/single_price"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="سعر الكيس"
                    android:inputType="number"
                    android:textColorHint="@color/black" />

                <EditText
                    android:id="@+id/all_price"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="سعر الكل"
                    android:inputType="number"
                    android:textColorHint="@color/black" />
            </LinearLayout>

            <!-- CheckBoxes -->
            <CheckBox
                android:id="@+id/has_offer_or_not"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="عليه عرض ؟"

                android:textColor="@color/black"
                android:textSize="20sp" />

            <CheckBox
                android:id="@+id/best_seller"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الاكثر مبيعا"

                android:textColor="@color/black"
                android:textSize="20sp" />

            <CheckBox
                android:id="@+id/offer_for_you"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="عرض ليك"
                android:textColor="@color/black"
                android:textSize="20sp" />

            <!-- EditTexts -->
            <EditText
                android:id="@+id/single_price_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"

                android:hint="اسم السعر المنفصل"
                />

            <EditText
                android:id="@+id/all_price_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"

                android:hint="اسم السعر كامل "
                />

            <Button
                android:id="@+id/add_item"
                android:layout_width="120dp"
                android:layout_height="60dp"
                android:text="اضافة "
                android:textColor="@color/white"
android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:textSize="20sp" />

            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>



</LinearLayout>
